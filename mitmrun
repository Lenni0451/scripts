#!/bin/bash

PORT=8080
WEB_PORT=8081

# Check if ports are already in use
if nc -z 127.0.0.1 $PORT 2>/dev/null; then
    echo "Error: Proxy port $PORT is already in use."
    exit 1
fi
if nc -z 127.0.0.1 $WEB_PORT 2>/dev/null; then
    echo "Error: Web UI port $WEB_PORT is already in use."
    exit 1
fi

echo "Starting mitmweb (Proxy on $PORT, Web UI on $WEB_PORT)..."
LOG_FILE=$(mktemp)
PYTHONUNBUFFERED=1 mitmweb -p $PORT --web-port $WEB_PORT --no-web-open > "$LOG_FILE" 2>&1 &
MITM_PID=$!

# Ensure mitmweb is killed when this script exits
trap 'kill $MITM_PID 2>/dev/null; rm -f "$LOG_FILE"' EXIT

# Wait for proxy to start listening
for i in {1..50}; do
    if nc -z 127.0.0.1 $PORT 2>/dev/null; then
        break
    fi
    if ! kill -0 $MITM_PID 2>/dev/null; then
        echo "Failed to start mitmweb. Check logs:"
        cat "$LOG_FILE"
        exit 1
    fi
    sleep 0.1
done

# Extract the web UI URL (with token) from the log file
WEB_URL=$(grep "Web server listening at" "$LOG_FILE" | awk '{print $6}' | tr -d '\r')
if [ -z "$WEB_URL" ]; then
    WEB_URL="http://127.0.0.1:$WEB_PORT"
fi
echo "View live traffic at: $WEB_URL"

# The mitmproxy CA cert must be trusted by the application
CA_CERT="$HOME/.mitmproxy/mitmproxy-ca-cert.pem"
if [ ! -f "$CA_CERT" ]; then
    echo "Warning: mitmproxy CA cert not found at $CA_CERT."
fi

# ==========================================
# 1. Standard Proxy & SSL Settings
# ==========================================
export HTTP_PROXY="http://127.0.0.1:$PORT"
export HTTPS_PROXY="http://127.0.0.1:$PORT"
export http_proxy="http://127.0.0.1:$PORT"
export https_proxy="http://127.0.0.1:$PORT"
export ALL_PROXY="http://127.0.0.1:$PORT"
export all_proxy="http://127.0.0.1:$PORT"

export SSL_CERT_FILE="$CA_CERT"
export REQUESTS_CA_BUNDLE="$CA_CERT"
export NODE_EXTRA_CA_CERTS="$CA_CERT"

# ==========================================
# 2. Java / JVM Specific Settings
# ==========================================
if command -v keytool >/dev/null 2>&1 && [ -f "$CA_CERT" ]; then
    JAVA_TRUSTSTORE="$HOME/.mitmproxy/mitmproxy-truststore.jks"
    # Create truststore if it doesn't exist, or if the PEM is newer than the JKS
    if [ ! -f "$JAVA_TRUSTSTORE" ] || [ "$CA_CERT" -nt "$JAVA_TRUSTSTORE" ]; then
        echo "Setting up Java truststore..."
        rm -f "$JAVA_TRUSTSTORE"
        if [ -f "/etc/ssl/certs/java/cacerts" ]; then
            cp "/etc/ssl/certs/java/cacerts" "$JAVA_TRUSTSTORE"
            chmod 644 "$JAVA_TRUSTSTORE"
        fi
        keytool -importcert -alias mitmproxy -keystore "$JAVA_TRUSTSTORE" -storepass changeit -file "$CA_CERT" -noprompt >/dev/null 2>&1
    fi
    
    if [ -f "$JAVA_TRUSTSTORE" ]; then
        export JAVA_TOOL_OPTIONS="-Dhttp.proxyHost=127.0.0.1 -Dhttp.proxyPort=$PORT -Dhttps.proxyHost=127.0.0.1 -Dhttps.proxyPort=$PORT -Djavax.net.ssl.trustStore=$JAVA_TRUSTSTORE -Djavax.net.ssl.trustStorePassword=changeit"
    fi
fi

if [ $# -gt 0 ]; then
    echo "Running command: $@"
    echo "----------------------------------------"

    # If the command is a flatpak, we must expose the ~/.mitmproxy directory 
    # to the sandbox so it can read the certificates.
    if [ "$1" = "flatpak" ] && [ "$2" = "run" ]; then
        set -- "flatpak" "run" "--filesystem=$HOME/.mitmproxy:ro" "${@:3}"
        echo "Detected Flatpak: Injected --filesystem=$HOME/.mitmproxy:ro to expose proxy certificates."
    fi

    # Run the user's command
    "$@"
    CMD_EXIT=$?

    echo "----------------------------------------"
    echo "Command finished with exit code $CMD_EXIT."
    echo "mitmweb is still running."
    echo "View live traffic at: $WEB_URL"
    echo "Press Ctrl+C to stop the proxy and exit."
else
    echo ""
    echo "================================================================="
    echo "                   Standalone Proxy Mode                         "
    echo "================================================================="
    echo "The proxy is running and waiting for external programs to connect!"
    echo ""
    echo "To intercept an external program manually, configure its proxy settings to use:"
    echo "  Type : HTTP"
    echo "  Host : 127.0.0.1"
    echo "  Port : $PORT"
    echo ""
    echo "If the program requires manual SSL certificate configuration, point it to the generated certificate or truststore:"
    echo "  PEM Cert   : $CA_CERT"
    echo "  Truststore : $JAVA_TRUSTSTORE"
    echo "  Password   : changeit"
    echo ""
    echo "To intercept a vanilla Java application directly, use these JVM arguments:"
    echo "  -Dhttp.proxyHost=127.0.0.1 -Dhttp.proxyPort=$PORT -Dhttps.proxyHost=127.0.0.1 -Dhttps.proxyPort=$PORT -Djavax.net.ssl.trustStore=$JAVA_TRUSTSTORE -Djavax.net.ssl.trustStorePassword=changeit"
    echo ""
    echo "View live traffic at: $WEB_URL"
    echo "Press Ctrl+C to stop the proxy and exit."
fi

wait $MITM_PID
